# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

node_modules/

# yarn
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# Compiled binary addons (https://nodejs.org/api/addons.html)
dist/
artifacts/
work/
ci/

# e2e test directories
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Editor
.idea

.eslintcache

# Internal planning docs. This repo is PUBLIC. The spec contains day-level
# estimates, unannounced pricing/billing deliberations, and file:line references
# into the private lakehouse repo, none of which should be world-readable. Keep the
# working copy here so it travels with the plugin, but do not publish it. If a
# public design doc is wanted, write a scrubbed one at docs/design.md instead.
docs/internal/

# Local credentials. This repo is PUBLIC -- .env carries live SDK/PAT tokens.
.env

# Playwright MCP session artefacts: page snapshots, console logs and screenshots
# written into the repo root while driving Grafana in a browser. Debugging output,
# not source.
.playwright-mcp/

# Ad-hoc screenshots taken while checking the UI.
/*.png

# Throwaway payloads written to the repo root while poking the API or Grafana by hand
# (query bodies, dashboard JSON, SQL). Deleted after use, ignored so a forgotten one
# cannot be committed.
/scratch-*
