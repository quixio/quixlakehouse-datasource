# Code owners for the QuixLakeHouse Grafana data source plugin.
#
# Every pull request requires approval from one of these owners. Combined with a
# ruleset on `main` that has "Require review from Code Owners" enabled, this is
# what guarantees an outside contributor cannot merge to a public repo.
#
# IMPORTANT: a team listed here must have at least *write* access to this repo,
# otherwise GitHub silently ignores the entry (Settings -> Collaborators and
# teams -> Add teams).

# Default owner for everything.
*                           @quixio/quix-saas

# Go backend — the query path, auth handling and Arrow conversion.
/pkg/                       @quixio/quix-saas

# Frontend — config editor, query editor, datasource wiring.
/src/                       @quixio/quix-saas

# Anything that changes how the plugin is built, signed or published.
/.github/                   @quixio/quix-saas
/Magefile.go                @quixio/quix-saas
/package.json               @quixio/quix-saas
/src/plugin.json            @quixio/quix-saas

# Deployment-shaped files: provisioning and the dev compose stack.
/provisioning/              @quixio/quix-saas
/docker-compose.dev.yml     @quixio/quix-saas
