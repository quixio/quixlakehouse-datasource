# Single source of truth for the plugin id in docker-compose.dev.yml.
#
# The id is FINAL. The first segment is our grafana.com organisation slug, now
# claimed as `quix` (org ID 1866430). Changing it here updates every reference in
# docker-compose.dev.yml; the other places it is spelled are listed in
# SPIKE-NOTES.md under "Plugin id -- rename inventory".
PLUGIN_ID=quix-quixlakehouse-datasource

# Host port for the spike Grafana. 3001 is taken by the running integration stack.
GRAFANA_PORT=3002

# Grafana version pinned to match the running integration stack.
GRAFANA_VERSION=13.1.1
